{
    "name": "acf/feature-card",
    "title": "Feature Card",
    "description": "A feature card with icon, heading, content and link.",
    "editorStyle": "bowst-press-global-styles",
    "style": "file:./style.css",
    "category": "bowst",
    "icon": "star-filled",
    "apiVersion": 3,
    "keywords": ["feature", "card", "service"],
    "acf": {
        "mode": "preview",
        "blockVersion": 3,
        "autoInlineEditing": true,
        "renderTemplate": "render.php"
    },
    "supports": {
        "align": false,
        "anchor": true,
        "alignContent": false,
        "color": {
            "text": false,
            "background": false,
            "link": false
        },
        "alignText": false,
        "spacing": {
            "margin": false,
            "padding": false
        },
        "typography": {
            "lineHeight": false,
            "fontSize": false
        },
        "fullHeight": false
    }
}
